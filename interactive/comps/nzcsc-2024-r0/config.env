# NZCSC 2024 Round 0 - archive reconstruction (reconstructed from the captured
# frontend; no original backend survived). Hosted on-demand like the 2026 comps.
COMP=nzcsc-2024-r0
CONTAINER_PREFIX=ctf-nzcsc-2024-r0       # containers: ctf-nzcsc-2024-r0-chall<id>
NETWORK=docker_caddy-net                 # the network Caddy (caddy-docker-proxy) watches
FLAG_FORMAT=NZCSC{...}

# --- LOCAL (LAN-only) domain: challNN.<BASE_DOMAIN>, restricted to LOCAL_CIDRS ---
BASE_DOMAIN=r0.2024.ctf.int.rowansserver.com
LOCAL_CIDRS=192.168.178.0/24 10.13.13.0/24
# PRIVATE-FOR-NOW: bind published raw-TCP (nc) challenge ports to the LAN IP only,
# so they don't listen on 0.0.0.0/the public interface. Blank to publish on all interfaces.
TCP_BIND=192.168.178.124

# --- PUBLIC domain (Cloudflare-proxied): challNN.<PUBLIC_DOMAIN> ; blank to disable ---
PUBLIC_DOMAIN=r0.2024.nzcsc.xyz
# When true, the PUBLIC site only answers requests coming from Cloudflare's edge IPs
# (so nobody can bypass the CF proxy/WAF by hitting the origin directly).
CLOUDFLARE_ONLY=true
# PRIVATE-FOR-NOW: when true, the PUBLIC domain is also restricted to LOCAL_CIDRS -
# i.e. reachable on the LAN but 403'd from the internet. Flip to false to re-open.
PUBLIC_LOCAL_ONLY=true
# "auto" = fetch the current list from Cloudflare's API at generation time.
CF_CIDRS=auto
