# NZCSC 2026 Round 2 - self-hosted challenge replica (recreated from the R2 dump).
COMP=nzcsc-r2
CONTAINER_PREFIX=ctf-nzcsc-r2            # containers: ctf-nzcsc-r2-chall<id>
NETWORK=docker_caddy-net
FLAG_FORMAT=NZCSC{...}

# LOCAL (LAN-only) domain: challNN.<BASE_DOMAIN>, restricted to LOCAL_CIDRS
BASE_DOMAIN=r2.2026.ctf.int.rowansserver.com
LOCAL_CIDRS=192.168.178.0/24 10.13.13.0/24
TCP_BIND=192.168.178.124

# PUBLIC domain (Cloudflare-proxied), kept LAN-only for now just like r0.
PUBLIC_DOMAIN=r2.2026.nzcsc.xyz
CLOUDFLARE_ONLY=true
PUBLIC_LOCAL_ONLY=true
CF_CIDRS=auto
